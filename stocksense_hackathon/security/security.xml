<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_stocksense" model="ir.module.category">
            <field name="name">StockSense</field>
            <field name="description">StockSense Intelligent Inventory Security &amp; Anomaly Detection</field>
            <field name="sequence">15</field>
        </record>

        <record id="group_stocksense_user" model="res.groups">
            <field name="name">Warehouse Staff</field>
            <field name="category_id" ref="module_category_stocksense"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
            <field name="comment">Warehouse Staff can submit operations, use VoiceOps, and request adjustments.</field>
        </record>

        <record id="group_stocksense_manager" model="res.groups">
            <field name="name">Inventory Manager</field>
            <field name="category_id" ref="module_category_stocksense"/>
            <field name="implied_ids" eval="[(4, ref('group_stocksense_user')), (4, ref('stock.group_stock_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Inventory Managers can approve/reject suspicious adjustments, change rule thresholds, and run Steward.</field>
        </record>
    </data>
</odoo>
